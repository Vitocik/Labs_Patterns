digraph BridgePattern {
  graph [rankdir=LR, bgcolor="white", pad="0.22", nodesep="0.48", ranksep="0.70", splines=ortho, fontname="Liberation Sans", fontsize=16, labelloc=t, label="Паттерн «Мост» — отделение способа вывода от модели движения"];
  node [shape=plain, fontname="Liberation Sans", fontsize=10.5];
  edge [fontname="Liberation Sans", fontsize=9.5, color="#4D4D4D", penwidth=1.2, arrowsize=0.8];

  Program [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#3F3F3F">
      <TR><TD BGCOLOR="#F8E6E7"><B>Program</B></TD></TR>
      <TR><TD ALIGN="LEFT">Клиент: выбирает симулятор<br/>и модель расчёта</TD></TR>
    </TABLE>>];

  TrajectorySimulator [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#333333">
      <TR><TD BGCOLOR="#F8E6E7"><B>«Мост»: TrajectorySimulator</B><BR/><I>abstract</I></TD></TR>
      <TR><TD ALIGN="LEFT">- _model: IFlightModel</TD></TR>
      <TR><TD ALIGN="LEFT">+ Simulate(parameters): TrajectoryResult<BR/># Display(parameters, result)</TD></TR>
    </TABLE>>];

  Summary [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#333333">
      <TR><TD BGCOLOR="#F7F0E4"><B>SummaryTrajectorySimulator</B></TD></TR>
      <TR><TD ALIGN="LEFT">Показывает время, высоту<br/>и дальность</TD></TR>
      <TR><TD ALIGN="LEFT">+ Display(...)</TD></TR>
    </TABLE>>];

  Detailed [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#333333">
      <TR><TD BGCOLOR="#F7F0E4"><B>DetailedTrajectorySimulator</B></TD></TR>
      <TR><TD ALIGN="LEFT">Показывает сводку и таблицу<br/>расчётных точек</TD></TR>
      <TR><TD ALIGN="LEFT">+ Display(...)</TD></TR>
    </TABLE>>];

  IFlightModel [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#333333">
      <TR><TD BGCOLOR="#E5ECF7"><B>&lt;&lt;interface&gt;&gt; IFlightModel</B></TD></TR>
      <TR><TD ALIGN="LEFT">+ Name: string<BR/>+ Calculate(parameters): TrajectoryResult</TD></TR>
    </TABLE>>];

  Ideal [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#333333">
      <TR><TD BGCOLOR="#E9F2E8"><B>IdealBallisticModel</B></TD></TR>
      <TR><TD ALIGN="LEFT">Расчёт без ветра</TD></TR>
    </TABLE>>];

  Wind [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#333333">
      <TR><TD BGCOLOR="#E9F2E8"><B>WindAffectedModel</B></TD></TR>
      <TR><TD ALIGN="LEFT">Учитывает горизонтальную<br/>скорость ветра</TD></TR>
    </TABLE>>];

  Program -> TrajectorySimulator [label="использует"];
  Summary -> TrajectorySimulator [arrowhead=empty, label="наследование"];
  Detailed -> TrajectorySimulator [arrowhead=empty];
  TrajectorySimulator -> IFlightModel [dir=both, arrowtail=diamond, arrowhead=vee, label="делегирует расчёт"];
  Ideal -> IFlightModel [style=dashed, arrowhead=empty];
  Wind -> IFlightModel [style=dashed, arrowhead=empty];

  {rank=same; Summary; Detailed;}
  {rank=same; Ideal; Wind;}
}
